# .env.example
GIGACHAT_API_KEY=...ваш_ключ...
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-Plus
GIGACHAT_VERIFY_SSL=

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
# REDIS_URL=redis://redis:6379/0

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
